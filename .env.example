# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./stock_intelligence.db

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Yahoo Finance API Settings
YAHOO_FINANCE_ENABLED=true
STOCK_SYMBOLS=AAPL,GOOGL,MSFT,AMZN,TSLA,META,NVDA,JPM,V,PG

# Data Settings
DATA_CACHE_DIR=./cache
MAX_HISTORY_YEARS=20
DEFAULT_TRAIN_SPLIT=0.7

# Forecasting Settings
DEFAULT_PREDICTION_DAYS=30
SEQUENCE_LENGTH=60
EPOCHS_LSTM=50
EPOCHS_GRU=50

# Backtesting Settings
INITIAL_CAPITAL=100000.0
TRANSACTION_COST=0.001
SLIPPAGE=0.0005